# Copy to .env for local development. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Local API port. Render supplies PORT automatically.
PORT=3001

# Per-IP request limit per hour and instance-wide daily provider-request cap.
RATE_LIMIT_PER_HOUR=15
DAILY_REQUEST_LIMIT=200
